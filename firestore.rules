rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'razanzahron00@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Data User: Setiap user HANYA bisa membaca dan menulis datanya sendiri
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Data Skor: Setiap user HANYA bisa membaca, membuat, dan mengubah skor miliknya sendiri
    match /game_scores/{scoreId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Data Teka-teki / Puzzles
    match /puzzles/{puzzleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.createdBy == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Data Admin
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
